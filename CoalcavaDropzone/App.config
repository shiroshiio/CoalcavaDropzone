<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
			<section name="CoalcavaDropzone.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
	</configSections>

	<!-- Enable High DPI awareness to eliminate blurry text -->
	<System.Windows.Forms.ApplicationConfigurationSection>
		<add key="DpiAwareness" value="PerMonitorV2" />
		<add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
	</System.Windows.Forms.ApplicationConfigurationSection>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<userSettings>
		<CoalcavaDropzone.Properties.Settings>
			<setting name="ClientRootPath" serializeAs="String">
				<value>C:\Users\Public\OneDrive - COALCAVA\Clientes\</value>
			</setting>
			<setting name="IsMuted" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="OpenOnStartup" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="ReembolsoRootPath" serializeAs="String">
				<value>C:\Users\Public\OneDrive - COALCAVA\DROPZONE_FLOW\</value>
			</setting>
			<setting name="SelectedAppUser" serializeAs="String">
				<value />
			</setting>
		</CoalcavaDropzone.Properties.Settings>
	</userSettings>
</configuration>